config lwo 'main'
	# Master switch. Left off by default until server/keys are filled in.
	option enabled '0'

	# Existing kernel WireGuard interface this proxy fronts (netifd name).
	option interface 'wg_mullvad'

	# Local loopback port WireGuard's peer endpoint must point at.
	# In /etc/config/network set the peer endpoint_host to 127.0.0.1 and
	# endpoint_port to this value.
	option listen_port '51820'

	# Real (remote) Mullvad WireGuard endpoint.
	option server ''
	option server_port '51820'

	# WireGuard public keys used as LWO XOR masks (base64, 44 chars).
	#   server_pubkey = the peer/server public key   (obfuscates outbound)
	#   client_pubkey = this interface's public key   (deobfuscates inbound)
	option server_pubkey ''
	option client_pubkey ''

	# fwmark placed on the proxy's outbound socket so its packets bypass the
	# VPN routing table. Must be unique; also used to add an ip rule. Empty
	# disables the mark (only safe if the server is already reachable off-tunnel).
	option fwmark '0x51820'

	# Restart the proxy automatically if a direction drops (e.g. WG restart).
	option auto_reconnect '1'
	option reconnect_delay '3'

	# error | warn | info | debug | trace
	option log_level 'info'

	# --- relay switching / failover (used by the `lwo-switch` helper) ---
	# WireGuard interface/peer/route sections that lwo-switch reconfigures:
	option wg_interface 'wg_mullvad'
	option wg_peer 'wgpeer_mullvad'
	option bypass_route 'lwo_bypass'
	# Treat the tunnel as down if the WG handshake is older than this (seconds):
	option handshake_max '180'
	# Active relay endpoint IP (set by lwo-switch):
	option active '193.32.249.73'

	# Automatic failover: when '1', the lwo-failover watcher checks the tunnel
	# every failover_interval seconds and, if the handshake is stale, rotates
	# through the peer list (in order) until one connects.
	option failover '0'
	option failover_interval '120'

	# Relay list update (`lwo-switch update`, or the LuCI "Update relay list" button):
	# fetches the LWO relays of this country (ISO code, e.g. 'nl') from the Mullvad API,
	# probes each one over WAN, and keeps only those reachable from here.
	# Also accepts a region: europe, north-america, south-america, asia, oceania,
	# middle-east, africa - or 'all'. A region's relays (at most region_per_country per
	# country) are first ranked by ping, then the best max_relays are tested.
	option country ''
	option region_per_country '3'
	# If no relay of the country/region works (or passes the access check), use the
	# fastest working relay anywhere. The country setting is kept, so the next update
	# tries it first again. Auto failover also runs an update when every listed relay is
	# down (at most once per 15 min).
	option fallback_any '0'
	# Access check (needs curl): after a relay connects, real traffic is sent through it.
	# Data must pass (access_data_url, 3 tries) and no access_url may answer 403 (a Cloudflare
	# browser challenge is fine), 429, nothing, or a page matching access_block_regex.
	# Relays that fail are dropped. In 'device' test mode it needs probe_address.
	option access_check '0'
	#option access_data_url 'https://www.yahoo.com/'
	#list access_url 'https://claude.ai/login'
	#list access_url 'https://api.anthropic.com/v1/models'
	#list access_url 'https://gemini.google.com/app'
	#list access_url 'https://www.google.com/search?q=weather'
	#list access_url 'https://www.cloudflare.com/'
	# How relays are tested:
	#   'switch' - move the main tunnel to each relay in turn (no extra device; the internet
	#              pauses a few seconds per relay, traffic is dropped, never leaked)
	#   'device' - test on a separate wg_probe interface with a SECOND Mullvad device key
	#              (the tunnel stays up). Create the key with `wg genkey` and add its public
	#              key to your account as a new device.
	option probe_mode 'switch'
	option probe_private_key ''
	# Tunnel IP of that second device (the Address line of its Mullvad config, e.g.
	# 10.66.12.34). Only needed for the access check in 'device' mode.
	option probe_address ''
	# Seconds to wait for a probe handshake before marking a relay unreachable.
	option probe_timeout '6'
	# Test at most this many relays per update (random pick; the current relay always first).
	option max_relays '20'
	# Working relays are then ranked by packet loss + latency over plain WAN (this many
	# pings each, all relays at once) and the list is saved best-first; the update switches
	# to the best one. Failover and "Next relay" follow that order.
	option rank_pings '15'

	# Candidate relays, one entry each: "ENDPOINT_IP PUBLIC_KEY [PORT]".
	# PORT is optional (any WireGuard port works for LWO) and defaults to
	# server_port above. IP + key come from https://api.mullvad.net/app/v1/relays.
	list peer '193.32.249.73 hf+klJbIyUoGUaFHgac9W+yriwb9uvSnafDfnmEW9Hc='
