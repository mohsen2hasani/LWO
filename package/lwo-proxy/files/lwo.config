config lwo 'main'
	# Master switch. Left off by default until server/keys are filled in.
	option enabled '0'

	# Existing kernel WireGuard interface this proxy fronts (netifd name).
	option interface 'wg_mullvad'

	# Local loopback port WireGuard's peer endpoint must point at.
	# In /etc/config/network set the peer endpoint_host to 127.0.0.1 and
	# endpoint_port to this value.
	option listen_port '51820'

	# Real (remote) Mullvad WireGuard endpoint.
	option server ''
	option server_port '51820'

	# WireGuard public keys used as LWO XOR masks (base64, 44 chars).
	#   server_pubkey = the peer/server public key   (obfuscates outbound)
	#   client_pubkey = this interface's public key   (deobfuscates inbound)
	option server_pubkey ''
	option client_pubkey ''

	# fwmark placed on the proxy's outbound socket so its packets bypass the
	# VPN routing table. Must be unique; also used to add an ip rule. Empty
	# disables the mark (only safe if the server is already reachable off-tunnel).
	option fwmark '0x51820'

	# Restart the proxy automatically if a direction drops (e.g. WG restart).
	option auto_reconnect '1'
	option reconnect_delay '3'

	# error | warn | info | debug | trace
	option log_level 'info'

	# --- relay switching / failover (used by the `lwo-switch` helper) ---
	# WireGuard interface/peer/route sections that lwo-switch reconfigures:
	option wg_interface 'wg_mullvad'
	option wg_peer 'wgpeer_mullvad'
	option bypass_route 'lwo_bypass'
	# Treat the tunnel as down if the WG handshake is older than this (seconds):
	option handshake_max '180'
	# Active relay endpoint IP (set by lwo-switch):
	option active '193.32.249.73'

	# Automatic failover: when '1', the lwo-failover watcher checks the tunnel
	# every failover_interval seconds and, if the handshake is stale, rotates
	# through the peer list (in order) until one connects.
	option failover '0'
	option failover_interval '120'

	# Candidate relays, one entry each: "ENDPOINT_IP PUBLIC_KEY [PORT]".
	# PORT is optional (LWO uses the same port across relays) and defaults to
	# server_port above. IP + key come from https://api.mullvad.net/app/v1/relays.
	list peer '193.32.249.73 hf+klJbIyUoGUaFHgac9W+yriwb9uvSnafDfnmEW9Hc='
