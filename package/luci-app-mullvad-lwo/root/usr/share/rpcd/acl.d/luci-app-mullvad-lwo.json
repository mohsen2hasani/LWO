{
	"luci-app-mullvad-lwo": {
		"description": "Grant access to Mullvad LWO status and configuration",
		"read": {
			"ubus": {
				"luci.lwo": [ "status", "logs", "countries" ]
			},
			"uci": [ "lwo" ]
		},
		"write": {
